{
  "template_matrix": {
    "prefix": "template_matrix",
    "body": [
      "struct matrix {",
      "    int n ; ",
      "    vector<vector<int>> a ; ",
      "    matrix ( int _n = 2 )",
      "    {",
      "        n = _n ; ",
      "        a.assign(n, vector<int>(n, 0)) ; ",
      "    } ",
      "",
      "    friend matrix operator * ( const matrix &A , const matrix &B ) ",
      "    {",
      "        int n = A.n ; ",
      "        matrix res(n) ; ",
      "        for ( int k = 0 ; k < n ; k ++ ) ",
      "            for ( int i = 0 ; i < n ; i ++ ) ",
      "                for ( int j = 0 ; j < n ; j ++ ) ",
      "                    add(res.a[i][j], 1ll * A.a[i][k] * B.a[k][j] % mod) ; ",
      "        return res ; ",
      "    }",
      "",
      "    matrix power ( long long exp )  ",
      "    {",
      "        matrix A = *this ; ",
      "        matrix res(n) ; ",
      "        for ( int i = 0 ; i < n ; i ++ ) res.a[i][i] = 1 ; ",
      "        while ( exp )  ",
      "        {",
      "            if ( exp % 2 ) res = res * A ; ",
      "            exp /= 2 ; ",
      "            A = A * A ; ",
      "        }",
      "        return res ; ",
      "    }",
      "};",
      "$1"
    ],
    "description": "C++ Competitive Programming Template - matrix struct (with multiplication and power)"
  }
}
