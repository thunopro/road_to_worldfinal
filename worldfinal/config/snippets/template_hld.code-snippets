      "        if ( dep [head [u]] < dep [head [v]] ) swap ( u , v ) ;",
      "        chkmax ( res , get ( tin [head [u]] , tin [u] ) ) ;",
      "        u = par [head [u]] [0] ;",
      "    }",
      "    if ( dep [u] > dep [v] ) swap ( u , v ) ;",
      "    chkmax ( res , get ( tin [u] , tin [v] ) ) ;",
      "    return res ;",
      "}",
