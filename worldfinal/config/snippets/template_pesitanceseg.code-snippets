{
  "CP_template": {
    "prefix": "template_persistence",
    "body": [
      "struct Node {",
      "    int left, right, sum;",
      "};",
      "",
      "const int maxn = 2e5 + 5;",
      "Node T[maxn * 40];",
      "int num_node = 0, root[maxn];",
      "int a[maxn];",
      "",
      "int build(int l, int r) {",
      "    int New_node = ++num_node;",
      "    if (l == r) {",
      "        T[New_node].sum = a[l];",
      "        return New_node;",
      "    }",
      "    int mid = (l + r) >> 1;",
      "    T[New_node].left = build(l, mid);",
      "    T[New_node].right = build(mid + 1, r);",
      "    T[New_node].sum = T[T[New_node].left].sum + T[T[New_node].right].sum;",
      "    return New_node;",
      "}",
      "",
      "int update(int id, int l, int r, int pos, int w) {",
      "    if (l > pos || r < pos) return id;",
      "    int New_node = ++num_node;",
      "    T[New_node] = T[id];",
      "    if (l == r) {",
      "        T[New_node].sum = w;",
      "        return New_node;",
      "    }",
      "    int mid = (l + r) >> 1;",
      "    T[New_node].left = update(T[id].left, l, mid, pos, w);",
      "    T[New_node].right = update(T[id].right, mid + 1, r, pos, w);",
      "    T[New_node].sum = T[T[New_node].left].sum + T[T[New_node].right].sum;",
      "    return New_node;",
      "}",
      "",
      "int get(int id, int l, int r, int u, int v) {",
      "    if (l > v || r < u) return 0;",
      "    if (u <= l && r <= v) return T[id].sum;",
      "    int mid = (l + r) >> 1;",
      "    return get(T[id].left, l, mid, u, v) + get(T[id].right, mid + 1, r, u, v);",
      "}"
    ],
    "description": "C++ Persistent Segment Tree Template"
  }
}
