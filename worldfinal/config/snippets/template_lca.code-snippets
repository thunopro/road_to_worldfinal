{
  "CP_LCA": {
    "prefix": "template_lca",
    "body": [
      "int tin[maxn], tout[maxn], sz[maxn];",
      "int timeDfs, par[maxn][20], dep[maxn];",
      "",
      "void dfs(int u) {",
      "    sz[u] = 1;",
      "    tin[u] = ++timeDfs;",
      "    for (auto v : adjList[u]) {",
      "        if (v == par[u][0]) continue;",
      "        par[v][0] = u; dep[v] = dep[u] + 1;",
      "        for (int i = 1; i <= 19; i++)",
      "            par[v][i] = par[par[v][i-1]][i-1];",
      "        dfs(v);",
      "        sz[u] += sz[v];",
      "    }",
      "    tout[u] = timeDfs;",
      "}",
      "",
      "int lca(int u, int v) {",
      "    if (dep[u] < dep[v]) swap(u, v);",
      "    int h = dep[u] - dep[v];",
      "    for (int i = 19; i >= 0; i--)",
      "        if (h >> i & 1) u = par[u][i];",
      "    if (u == v) return u;",
      "    for (int i = 19; i >= 0; i--)",
      "        if (par[u][i] != par[v][i])",
      "            u = par[u][i], v = par[v][i];",
      "    return par[u][0];",
      "}",
      "",
      "bool is_parent(int u, int v) {",
      "    return (tin[u] <= tin[v] && tin[v] <= tout[u]);",
      "}",
      "",
      "int jump(int u, int h) {",
      "    for (int i = 19; i >= 0; i--)",
      "        if (h >> i & 1) u = par[u][i];",
      "    return u;",
      "}"
    ],
    "description": "C++ LCA Template with DFS, Binary Lifting, and Ancestor Utilities"
  }
}
