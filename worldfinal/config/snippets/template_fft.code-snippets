      "const int mod = 998244353 ;",
      "const int G = 3 ;",
      "void ntt(vector<int> &a, bool invert) {",
      "    int n = a.size();",
      "    static vector<int> rev;",
      "",
      "    if ((int)rev.size() != n) {",
      "        rev.assign(n, 0);",
      "        for (int i = 1, j = 0; i < n; i++) {",
      "            int bit = n >> 1;",
      "            for (; j & bit; bit >>= 1) j ^= bit;",
      "            j ^= bit;",
      "            rev[i] = j;",
      "        }",
      "    }",
      "",
      "    for (int i = 0; i < n; i++)",
      "        if (i < rev[i]) swap(a[i], a[rev[i]]);",
      "",
      "    for (int len = 2; len <= n; len <<= 1) {",
      "        int wlen = _pow(G, (mod - 1) / len);",
      "        if (invert) wlen = _pow(wlen, mod - 2);",
      "        for (int i = 0; i < n; i += len) {",
      "            int w = 1;",
      "            for (int j = 0; j < len / 2; j++) {",
      "                int u = a[i + j], v = 1LL * a[i + j + len / 2] * w % mod;",
      "                a[i + j] = (u + v < mod ? u + v : u + v - mod);",
      "                a[i + j + len / 2] = (u - v >= 0 ? u - v : u - v + mod);",
      "                w = 1LL * w * wlen % mod;",
      "            }",
      "        }",
      "    }",
      "",
      "    if (invert) {",
      "        int inv_n = _pow(n, mod - 2);",
      "        for (int &x : a) x = 1LL * x * inv_n % mod;",
      "    }",
      "}",
      "",
      "vector<int> multiply(const vector<int>& A, const vector<int>& B, int K) {",
      "    int na = min<int>(A.size(), K + 1);",
      "    int nb = min<int>(B.size(), K + 1);",
      "    if (!na || !nb) return {};",
      "    int need = min(K + 1, na + nb - 1);",
      "",
      "    vector<int> a(A.begin(), A.begin() + na);",
      "    vector<int> b(B.begin(), B.begin() + nb);",
      "",
      "    int n = 1;",
      "    while (n < na + nb - 1) n <<= 1;",
      "    a.resize(n); b.resize(n);",
      "",
      "    ntt(a, false); ntt(b, false);",
      "    for (int i = 0; i < n; i++) a[i] = 1LL * a[i] * b[i] % mod;",
      "    ntt(a, true);",
      "",
      "    a.resize(need);",
      "    return a;",
      "}",
      "",
      "vector<int> POW(vector<int> base, long long exp, int K) {",
      "    if ((int)base.size() > K + 1) base.resize(K + 1);",
      "",
      "    vector<int> res(1, 1);",
      "    while (exp > 0) {",
      "        if (exp & 1) res = multiply(res, base, K);",
      "        exp >>= 1;",
      "        if (exp) base = multiply(base, base, K);",
      "    }",
      "    return res;",
      "}"
    ],
    "description": "C++ Template for NTT and Polynomial Power (limited to degree K)"
