{
  "CP_template": {
    "prefix": "template_ckn",
    "body": [
      "int fac [maxn] , ifac [maxn] ;",
      "void build_ckn () ",
      "{",
      "    const int N = 2e5 ;",
      "    fac [0] = ifac [0] = 1 ;",
      "    for ( int i = 1 ; i <= N ; i ++ ) fac [i] = 1ll * fac[i-1] * i % mod ;",
      "    ifac [N] = _pow (fac[N], mod - 2) ;",
      "    for ( int i = N - 1 ; i >= 1 ; i -- ) ifac [i] = 1ll * ifac[i+1] * (i+1) % mod ;",
      "}",
      "int ckn ( int k , int n ) ",
      "{",
      "    return 1ll * fac[n] * ifac[k] % mod * ifac[n-k] % mod ;",
      "}"
    ],
    "description": "C++ Template for Combination (n choose k) with modular inverse"
  }
}
